# 프로덕션(gh-pages) 빌드 설정.
# 하이브리드: 클라우드 백엔드(Render)는 AI 분석·추천·챗봇·검색을 담당하고,
# 실제 RPA(서류발급/자동신청)는 사용자 PC의 로컬 에이전트(localhost:8000)가 담당한다.
# backend.ts가 아래 주소 → 로컬 에이전트 순으로 감지하며, 클라우드 콜드스타트도 웨이크업 재시도한다.
#
# ⚠️ 아래를 Render 대시보드에서 만든 실제 서비스 URL로 교체 후 `npm run deploy` 하세요.
#    예: VITE_API_BASE=https://modoo-bom-api.onrender.com
#    (비워두면 클라우드 AI 기능 없이 로컬 엔진 + 로컬 에이전트로만 동작)
VITE_API_BASE=https://modoo-bom.onrender.com

# 로그인·동기화(Supabase)는 프로덕션에서 기본 비활성 — .env(로컬 개발용)의 값이 배포 번들에
# 섞이지 않도록 빈 값으로 override. 라이브에 로그인을 켜려면 실제 URL/키를 채워 재배포한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
