# 프로덕션(gh-pages) 빌드 설정.
# 정적 배포에는 백엔드가 없다. RPA 등 자동화는 사용자 PC의 로컬 에이전트(localhost:8000)를
# backend.ts가 감지해 활성화하므로 VITE_API_BASE는 비워둔다(옛 onrender 백엔드는 다운).
VITE_API_BASE=

# 로그인·동기화(Supabase)는 프로덕션에서 기본 비활성 — .env(로컬 개발용)의 값이 배포 번들에
# 섞이지 않도록 빈 값으로 override. 라이브에 로그인을 켜려면 실제 URL/키를 채워 재배포한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
