{
  "name": "modoo-bom-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/clean-wasm.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages --nojekyll -m \"deploy: 모두봄 프론트엔드 정적 빌드\"",
    "test": "vitest run",
    "e2e": "../backend/venv/Scripts/python.exe e2e/smoke.py",
    "e2e:save": "../backend/venv/Scripts/python.exe e2e/audit-flow.py",
    "e2e:chat": "../backend/venv/Scripts/python.exe e2e/audit-chat.py",
    "e2e:fin": "../backend/venv/Scripts/python.exe e2e/audit-fin.py",
    "e2e:ext": "../backend/venv/Scripts/python.exe e2e/ext-flow.py",
    "e2e:ext:headed": "cross-env EXT_HEADED=1 ../backend/venv/Scripts/python.exe e2e/ext-flow.py",
    "embed": "node --experimental-strip-types scripts/embed-policies.mts",
    "verify:semantic": "node scripts/verify-semantic.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
