# ──────────────────────────────────────────────
# ModooBom 백엔드 환경변수
# 이 파일을 .env 로 복사하고 값을 채우세요:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── AI provider (아무 키도 없으면 규칙기반 폴백으로 전 기능 동작) ──
# 우선순위 자동선택: Gemini > Groq > Anthropic. AI_PROVIDER 로 강제 지정 가능(gemini|groq|anthropic).
# AI_PROVIDER=gemini

# [권장·무료] Google Gemini — https://aistudio.google.com/app/apikey (무료 쿼터 넉넉)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# [무료] Groq — https://console.groq.com/keys (매우 빠름)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [선택] Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# [보안·배포] 관리자 엔드포인트(/api/admin/*) 보호 토큰. 미설정 시 관리 기능 비활성(404).
# 공개 배포(Render 등) 시 반드시 임의의 긴 값으로 설정하고, 호출 시 X-Admin-Token 헤더로 전달.
ADMIN_TOKEN=

# [보안·배포] WebSocket 남용 방지(무제한 LLM 호출 차단). IP별 분당 한도 — 기본값은 데모/경진대회를
# 깨지 않게 넉넉하다(사람은 못 넘고 스크립트만 차단). 실제 공개 런칭 시 낮춰 비용을 방어한다.
WS_MAX_MSG_PER_MIN=90
WS_MAX_CONN_PER_MIN=60

# ── 데이터/인프라 ──
# [필수·데이터 수집] 공공데이터포털 복지서비스 키 (한국사회보장정보원 B554287)
DATA_GO_KR_SERVICE_KEY=

# [선택·데이터 확장] 온통청년 청년정책 API 키 — 발급 후 `python etl/ingest_welfare.py --youth`
# 발급: youthcenter.go.kr 마이페이지 → OPEN API (담당자 검토 후 승인)
YOUTH_API_KEY=

# [선택] RAG 시딩 상한(메모리 제약 배포용). 미지정 시 전체
# RAG_MAX_DOCS=800

# [선택] 로그 레벨(DEBUG/INFO/WARNING/ERROR). 기본 INFO. PII는 로그에 남기지 않음.
LOG_LEVEL=INFO

# [선택] ChromaDB 데이터 저장 경로
CHROMA_PERSIST_DIR=./chroma_db

# [선택] 허용할 프론트엔드 주소(콤마 구분). 배포 웹 포함
CORS_ORIGINS=http://localhost:5173,https://biocode67.github.io

# 🤖 AI 채움(β) — 규칙 엔진이 못 채운 칸을 LLM이 '화면 구조만' 보고 보완(값·개인정보는 절대 미전송, 로컬 실키 입력)
#   위 GEMINI_API_KEY(또는 GROQ_API_KEY/ANTHROPIC_API_KEY)가 있으면 자동 활성. 끄려면 RPA_AI_FILL=0
RPA_AI_FILL=1
# AI 파일럿 v2 옵트인: RPA_AI_VISION=1 → 입력값을 가린 마스킹 스크린샷을 멀티모달로 전송(Gemini/Claude 키)
#                      RPA_AI_CLICK=1  → LLM 클릭 행동 허용(허용목록 버튼만, 제출·결제류는 항상 거부)
RPA_AI_VISION=0
RPA_AI_CLICK=0
