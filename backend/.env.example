# ──────────────────────────────────────────────
# ModooBom 백엔드 환경변수
# 이 파일을 .env 로 복사하고 값을 채우세요:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── AI provider (아무 키도 없으면 규칙기반 폴백으로 전 기능 동작) ──
# 우선순위 자동선택: Gemini > Groq > Anthropic. AI_PROVIDER 로 강제 지정 가능(gemini|groq|anthropic).
# AI_PROVIDER=gemini

# [권장·무료] Google Gemini — https://aistudio.google.com/app/apikey (무료 쿼터 넉넉)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# [무료] Groq — https://console.groq.com/keys (매우 빠름)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [선택] Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# [보안·배포] 관리자 엔드포인트(/api/admin/*) 보호 토큰. 미설정 시 관리 기능 비활성(404).
# 공개 배포(Render 등) 시 반드시 임의의 긴 값으로 설정하고, 호출 시 X-Admin-Token 헤더로 전달.
ADMIN_TOKEN=

# ── 데이터/인프라 ──
# [필수·데이터 수집] 공공데이터포털 복지서비스 키 (한국사회보장정보원 B554287)
DATA_GO_KR_SERVICE_KEY=

# [선택] RAG 시딩 상한(메모리 제약 배포용). 미지정 시 전체
# RAG_MAX_DOCS=800

# [선택] 로그 레벨(DEBUG/INFO/WARNING/ERROR). 기본 INFO. PII는 로그에 남기지 않음.
LOG_LEVEL=INFO

# [선택] ChromaDB 데이터 저장 경로
CHROMA_PERSIST_DIR=./chroma_db

# [선택] 허용할 프론트엔드 주소(콤마 구분). 배포 웹 포함
CORS_ORIGINS=http://localhost:5173,https://biocode67.github.io
